# PostgreSQL connection for the READ-ONLY role (see db/readonly_role.sql)
DATABASE_URL=postgresql://meridian_reader:PASSWORD@HOST/DBNAME?sslmode=require

# LLM: set one provider's key. LLM_PROVIDER picks explicitly when both are set.
LLM_PROVIDER=            # anthropic | gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SCOUT_MODEL=             # optional model override, e.g. claude-haiku-5-5

# Required on a public deployment: callers must send this as X-Access-Token
MERIDIAN_ACCESS_TOKEN=
