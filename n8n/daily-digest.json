{
  "name": "Meridian - daily executive digest",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "0 7 * * 1-5" } ] }
      },
      "id": "a1f3b6d0-1c1e-4a7e-9a10-000000000001",
      "name": "Weekdays at 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-MERIDIAN-HOST/api/digest/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 120000 }
      },
      "id": "a1f3b6d0-1c1e-4a7e-9a10-000000000002",
      "name": "Run Meridian digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000,
      "credentials": { "httpHeaderAuth": { "id": "", "name": "Meridian access token (X-Access-Token)" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.anomalies.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1f3b6d0-1c1e-4a7e-9a10-000000000003",
      "name": "Any anomalies?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "#leadership", "mode": "name" },
        "text": "=:rotating_light: {{ $json.anomalies.length }} metric(s) need attention\n\n{{ $json.slack }}",
        "otherOptions": {}
      },
      "id": "a1f3b6d0-1c1e-4a7e-9a10-000000000004",
      "name": "Alert leadership channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [780, -100],
      "credentials": { "slackApi": { "id": "", "name": "Slack account" } }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "#metrics", "mode": "name" },
        "text": "={{ $json.slack }}",
        "otherOptions": {}
      },
      "id": "a1f3b6d0-1c1e-4a7e-9a10-000000000005",
      "name": "Post routine digest",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [780, 100],
      "credentials": { "slackApi": { "id": "", "name": "Slack account" } }
    }
  ],
  "connections": {
    "Weekdays at 07:00": { "main": [ [ { "node": "Run Meridian digest", "type": "main", "index": 0 } ] ] },
    "Run Meridian digest": { "main": [ [ { "node": "Any anomalies?", "type": "main", "index": 0 } ] ] },
    "Any anomalies?": {
      "main": [
        [ { "node": "Alert leadership channel", "type": "main", "index": 0 } ],
        [ { "node": "Post routine digest", "type": "main", "index": 0 } ]
      ]
    }
  },
  "settings": { "executionOrder": "v1", "timezone": "Africa/Douala" },
  "active": false
}
